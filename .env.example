# Single-bot mode. For several isolated bots in one process, use bots.toml
# instead (see bots.example.toml) -- it takes precedence over this file.
#
# ---- Telegram ----------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# REQUIRED. Comma-separated numeric Telegram user IDs allowed to use the bot.
# The bot gives whoever is listed here shell access to the workspace, so this
# must never be left empty. Get your ID from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# ---- Claude ------------------------------------------------------------
# API key for the Claude Code CLI (or log in once with `claude login`).
ANTHROPIC_API_KEY=

# Name shown in /status and the logs.
BOT_NAME=default

# Directory the agent is confined to. Every session runs inside it and
# /cd cannot escape it.
CLAUDE_WORKSPACE=./workspace

# Model alias or full ID (default: whatever the CLI is configured with).
CLAUDE_MODEL=

# default | acceptEdits | plan | dontAsk | bypassPermissions | auto
# "default" asks you in Telegram before every tool call.
CLAUDE_PERMISSION_MODE=default

# Reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=

# Comma-separated tool names auto-approved without a Telegram prompt,
# e.g. Read,Glob,Grep
CLAUDE_ALLOWED_TOOLS=

# Comma-separated tool names the agent may never use.
CLAUDE_DISALLOWED_TOOLS=

# ---- Bot behaviour -----------------------------------------------------
# Seconds to wait for a permission answer before auto-denying.
PERMISSION_TIMEOUT=300

# Show thinking blocks and tool results by default (1/0).
VERBOSE_DEFAULT=0

# Hard cap on agentic turns per prompt (blank = unlimited).
CLAUDE_MAX_TURNS=
